FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

# Build .next INTO the image (avoids unreliable Windows bind-mount .next reads).
# NEXT_PUBLIC_* are baked from .env.production at build time.
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
