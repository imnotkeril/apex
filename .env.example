# ─── DATABASE ─────────────────────────────────────────────
POSTGRES_PASSWORD=your_strong_password_here
DATABASE_URL=postgresql+asyncpg://apex_user:your_strong_password_here@postgres:5432/apex

# ─── REDIS / CELERY ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── SUPABASE AUTH ────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase Dashboard → Settings → API (JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ─── AI API KEYS (optional; leave empty if unused) ───────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GROK_API_KEY=
GOOGLE_AI_API_KEY=

# ─── APP SETTINGS ─────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# ─── MULTI-TENANCY BOOTSTRAP ──────────────────────────────
# New Google users are attached to this organisation (created if missing).
DEFAULT_ORG_SLUG=default
DEFAULT_ORG_NAME=APEX Default

# ─── COST CONTROLS ────────────────────────────────────────
MAX_AI_COST_PER_DAY_USD=20.0
